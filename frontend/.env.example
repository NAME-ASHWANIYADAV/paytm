# MunshiJi companion screen - default dev configuration.
#
# VITE_USE_FIXTURES:
#   auto  (default) try the API once; if it is not up, run entirely on fixtures
#   1 | true   never touch the network - guaranteed-offline demo mode
#   0 | false  live only, never fall back (useful when debugging the backend)
VITE_USE_FIXTURES=auto

# Merchant the companion screen is bound to.
# `default` is an alias the API resolves to the only merchant in a seeded database, so this works
# against a fresh backend without anyone copying an id across. Set a real `mer_…` id only when a
# database holds more than one shop.
VITE_MERCHANT_ID=default

# Where the API lives. Leave empty to use the Vite dev proxy (/api -> localhost:8000).
VITE_API_BASE=
